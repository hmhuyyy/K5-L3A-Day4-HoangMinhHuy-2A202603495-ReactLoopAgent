# Đặt biến trong shell; file này chỉ là mẫu, Python không tự đọc .env.
export PROVIDER=openai
export MODEL=YOUR_TOOL_CALLING_MODEL
export OPENAI_API_KEY=YOUR_KEY
# For an OpenAI-compatible service, set its HTTPS API base URL (without /chat/completions).
# export OPENAI_BASE_URL=https://api.example.com/v1
# For a Gemini-compatible service, set its HTTPS API base URL (without /v1beta/...).
# export GEMINI_API_KEY=YOUR_KEY
# export GOOGLE_GEMINI_BASE_URL=https://api.example.com
# export ANTHROPIC_API_KEY=YOUR_KEY
# export ANTHROPIC_BASE_URL=https://api.shopaikey.com
# export OPENROUTER_API_KEY=YOUR_KEY
